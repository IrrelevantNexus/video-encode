# Common host root bind-mounted into the container. Job paths below are container paths.
MEDIA_ROOT_HOST_DIR=

# Each job is name|input|output|Plex Section ID|Plex input path|Plex output path.
# Separate jobs with semicolons. Paths must not contain | or ;.
JOBS=

# --- CPU impact on the host ---
# CPU_CORES pins the container to specific host cores (docker-compose cpuset); CPU_LIMIT caps
# total CPU time (core-equivalents). FFMPEG_NICE_LEVEL/FFMPEG_IONICE_* lower ffmpeg's scheduling
# and I/O priority so it yields to other work under contention. Adjust CPU_CORES/CPU_LIMIT to
# your host's core count.
CPU_CORES=0-15
CPU_LIMIT=16
FFMPEG_NICE_LEVEL=15
FFMPEG_IONICE_CLASS=2
FFMPEG_IONICE_LEVEL=7
# Re-picks core count/niceness per file from current host load instead of a fixed affinity.
DYNAMIC_AFFINITY=true
MIN_ENCODE_CORES=2
MAX_ENCODE_CORES=

# --- Scan behavior ---
WORK_DIR=/var/tmp/video-encode-work
LOCK_FILE=/var/tmp/video-encode.lock
SCAN_INTERVAL_SECONDS=300
STABLE_CHECK_SECONDS=30
FILE_LOCK_STALE_SECONDS=21600
TEMP_FILE_SUFFIXES=.part .tmp .partial .download
VIDEO_EXTENSIONS=mkv mp4 avi mov m4v ts wmv flv webm
EXTRACT_ARCHIVES=true
SAMPLE_DIR_NAMES=sample samples preview previews
SKIP_IF_ALREADY_HEVC=true
DURATION_TOLERANCE_SECONDS=5

# --- Encoding ---
# Tried in order for every file; use nvenc,qsv,software for automatic fallback.
HW_ACCEL_ORDER=nvenc,qsv,software
CRF=20
PRESET=medium
NVENC_CQ=23
NVENC_PRESET=p5
QSV_QUALITY=23
AUDIO_CODEC=copy
PLEX_METADATA_MIGRATION=false
PLEX_MIGRATION_TIMEOUT_SECONDS=900

# --- Plex targeted-scan notification (all three required to enable) ---
PLEX_URL=http://plex:32400
PLEX_TOKEN=
