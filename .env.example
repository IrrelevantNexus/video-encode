# Common host root bind-mounted into the container. Job paths below are container paths.
MEDIA_ROOT_HOST_DIR=/mnt/gaia

# Each job is name|input|output|Plex Section ID|Plex input path|Plex output path.
# Separate jobs with semicolons. Paths must not contain | or ;.
JOBS=

# --- Scan behavior ---
WORK_DIR=/var/tmp/video-encode-work
LOCK_FILE=/var/tmp/video-encode.lock
SCAN_INTERVAL_SECONDS=300
STABLE_CHECK_SECONDS=30
TEMP_FILE_SUFFIXES=.part .tmp .partial .download
VIDEO_EXTENSIONS=mkv mp4 avi mov m4v ts wmv flv webm
SKIP_IF_ALREADY_HEVC=true
DURATION_TOLERANCE_SECONDS=5

# --- Encoding ---
# Tried in order for every file; use nvenc,qsv,software for automatic fallback.
HW_ACCEL_ORDER=nvenc,qsv,software
CRF=20
PRESET=medium
NVENC_CQ=23
NVENC_PRESET=p5
QSV_QUALITY=23
AUDIO_CODEC=copy
PLEX_METADATA_MIGRATION=false
PLEX_MIGRATION_TIMEOUT_SECONDS=900

# --- Plex targeted-scan notification (all three required to enable) ---
PLEX_URL=http://plex:32400
PLEX_TOKEN=
